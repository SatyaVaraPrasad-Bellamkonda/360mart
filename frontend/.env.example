# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Secret used to sign login sessions. Generate one with:  openssl rand -base64 32
SESSION_SECRET=

# true = local test login (OTP is always 123456, no SMS sent).
# Leave unset on the live site until the real backend is connected;
# login then shows "not available yet" instead of accepting anyone.
AUTH_MOCK=

# Admin account used by test login.
ADMIN_EMAIL=
ADMIN_PASSWORD=
