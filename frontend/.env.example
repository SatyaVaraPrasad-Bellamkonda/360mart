# Copy this file to .env.local and fill in the values. Never commit .env.local.
# On Vercel, set the same names under Project → Settings → Environment Variables.

# Spring Boot API base URL. Read on the server only (no NEXT_PUBLIC_ prefix),
# so the browser never sees it and one build can point at any backend.
#   Local (docker compose):  http://localhost:8080/api/v1
#   Production:              https://api.360mart.in/api/v1   (must be https)
API_URL=http://localhost:8080/api/v1

# Encrypts the logged-in user's details stored in the MART360_USER cookie
# (loaded from /users/me at login, refreshed every 15 minutes). At least 32
# random characters; generate with:  openssl rand -base64 48
# Use a different value per environment. Changing it just makes users' stored
# details reload once (nobody is logged out).
SESSION_SECRET=

# Optional. The session cookie is HTTPS-only in production builds. Set to false
# only to test a production build (`next start`) over plain http://localhost.
# COOKIE_SECURE=false

# Optional. Map tiles for "Pin your exact location" on the address form
# (MapLibre style JSON). Defaults to OpenFreeMap (free, no API key).
# MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Optional. Nominatim-compatible server for the address form's place search and
# for filling city, state and pincode from the map pin. Leave unset to turn
# both off (the map pin itself still works).
# Production: self-host Nominatim (or a provider). The public server below is
# for light local testing only: max 1 request/second, no heavy use.
# GEOCODER_URL=https://nominatim.openstreetmap.org

# Optional, development only (`npm run dev`). Log of every backend call in the
# terminal and the browser console (filter by "[api]"): who made it, the
# request and the response, with passwords, OTPs, tokens, phone numbers and
# coordinates masked.  full (default) = with request + response,
# basic = one line per call, off = nothing. Production never logs bodies.
# API_LOG=basic
